---
import Layout from '../layouts/Layout.astro';
import ColorBlockSection from '../components/ColorBlockSection.astro';
import Icon from '../components/Icon.astro';
---

<Layout 
  title="About AduraTools — Engineering & Mission"
  description="Discover the story and technical architecture behind AduraTools: built for speed, privacy, and delightful web utility experiences."
>
  <div class="max-w-[1000px] mx-auto py-14 px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Header -->
    <div class="space-y-4">
      <div class="font-eyebrow text-[var(--color-ink-muted)]">Mission & Architecture</div>
      <h1 class="font-display-lg text-4xl sm:text-5xl text-[var(--color-ink)]">
        About AduraTools
      </h1>
      <p class="font-body-lg text-[var(--color-ink-muted)] leading-relaxed">
        AduraTools is an open, fast, and meticulously crafted online tools platform designed to empower developers, designers, content creators, and students with zero-friction digital utilities.
      </p>
    </div>

    <!-- Editorial Story Block (Lilac) -->
    <ColorBlockSection variant="lilac">
      <div class="space-y-4">
        <div class="font-mono text-xs font-bold uppercase tracking-wider opacity-80">Our Core Philosophy</div>
        <h2 class="font-sans font-bold text-2xl sm:text-3xl">
          Why we built AduraTools
        </h2>
        <p class="font-body text-base sm:text-lg leading-relaxed opacity-90">
          The modern web is filled with utility websites cluttered with slow trackers, aggressive popups, arbitrary paywalls, and privacy risks. We wanted a clean, beautiful, Figma-inspired editorial experience that opens instantly, respects human attention, and executes tasks with precision.
        </p>
      </div>
    </ColorBlockSection>

    <!-- Technical Stack Highlights -->
    <div class="space-y-6">
      <h2 class="font-card-title text-2xl text-[var(--color-ink)]">
        Technology Stack
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-[var(--radius-lg)] bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] space-y-2">
          <div class="flex items-center gap-2 text-[var(--color-ink-muted)]">
            <Icon name="code" class="w-4 h-4" />
            <span class="font-mono text-xs font-bold uppercase">Framework</span>
          </div>
          <div class="font-sans font-bold text-xl text-[var(--color-ink)]">Astro 5+</div>
          <p class="font-body-sm text-xs text-[var(--color-ink-muted)] leading-relaxed">
            Zero-JavaScript static HTML islands deliver sub-millisecond page loads with minimal client footprint.
          </p>
        </div>

        <div class="p-6 rounded-[var(--radius-lg)] bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] space-y-2">
          <div class="flex items-center gap-2 text-[var(--color-ink-muted)]">
            <Icon name="palette" class="w-4 h-4" />
            <span class="font-mono text-xs font-bold uppercase">Styling</span>
          </div>
          <div class="font-sans font-bold text-xl text-[var(--color-ink)]">Tailwind CSS v4</div>
          <p class="font-body-sm text-xs text-[var(--color-ink-muted)] leading-relaxed">
            Next-gen CSS engine powered by `@import "tailwindcss"` and strict token adherence to DESIGN.md.
          </p>
        </div>

        <div class="p-6 rounded-[var(--radius-lg)] bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] space-y-2">
          <div class="flex items-center gap-2 text-[var(--color-ink-muted)]">
            <Icon name="cpu" class="w-4 h-4" />
            <span class="font-mono text-xs font-bold uppercase">Execution Engine</span>
          </div>
          <div class="font-sans font-bold text-xl text-[var(--color-ink)]">Web APIs</div>
          <p class="font-body-sm text-xs text-[var(--color-ink-muted)] leading-relaxed">
            Native browser Web Crypto API, Canvas 2D, and TextDecoder execute 100% of calculations in memory.
          </p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="pt-6 border-t border-[var(--color-hairline)] flex flex-wrap items-center justify-between gap-4">
      <div>
        <h3 class="font-sans font-bold text-lg text-[var(--color-ink)]">Ready to explore?</h3>
        <p class="font-body-sm text-sm text-[var(--color-ink-muted)]">Discover all utilities available on AduraTools today.</p>
      </div>
      <a href="/all-tools" class="btn-primary text-sm py-2 px-6">
        Browse All Tools →
      </a>
    </div>
  </div>
</Layout>
