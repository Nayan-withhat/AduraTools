---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Server Error (500) — AduraTools"
  description="Something went wrong on our side. Please try again or return to the homepage."
>
  <div class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_rgba(197,176,244,0.2),_transparent_30%),radial-gradient(circle_at_bottom_right,_rgba(220,238,177,0.25),_transparent_35%)]"></div>

    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="relative rounded-[32px] border border-[var(--color-hairline)] bg-[var(--color-surface-card)] p-6 shadow-[0_24px_80px_rgba(0,0,0,0.06)] sm:p-8 lg:p-12">
        <div class="absolute inset-x-10 top-6 h-px bg-[var(--color-hairline)]"></div>

        <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="space-y-6">
            <div class="inline-flex items-center gap-2 rounded-full border border-[var(--color-hairline)] bg-[var(--color-surface-soft)] px-3 py-1.5 font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--color-ink)]">
              Error 500
            </div>

            <div class="space-y-4">
              <div class="text-[clamp(80px,18vw,190px)] font-black leading-none tracking-[-0.08em] text-[var(--color-ink)]/10">
                500
              </div>
              <h1 class="font-display-lg text-[var(--color-ink)]">
                Something broke on our side.
              </h1>
            </div>

            <p class="max-w-lg font-body-lg text-[var(--color-ink-muted)]">
              We hit a temporary issue while preparing this page. Try refreshing, or head back home while we fix it.
            </p>

            <div class="flex flex-wrap items-center gap-3 pt-2">
              <a href="/" class="btn-primary text-sm py-2.5 px-6">
                Refresh Home
              </a>
              <button type="button" class="btn-secondary text-sm py-2.5 px-6" onclick="window.location.reload()">
                Reload Page
              </button>
            </div>
          </div>

          <div class="relative">
            <div class="rounded-[28px] border border-[var(--color-hairline)] bg-[var(--color-surface-soft)] p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] sm:p-8">
              <div class="mb-6 flex items-center justify-between">
                <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink-muted)]">
                  Status log
                </span>
                <span class="rounded-full border border-[var(--color-hairline)] bg-[var(--color-block-lilac)] px-2 py-1 text-[10px] font-medium uppercase tracking-[0.12em] text-[var(--color-ink)]">
                  retry
                </span>
              </div>

              <div class="space-y-3">
                <div class="rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-surface-card)] p-4">
                  <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink-muted)]">System</p>
                  <p class="mt-2 font-headline text-[20px] text-[var(--color-ink)]">Temporary outage</p>
                  <p class="mt-1 font-body-sm text-[var(--color-ink-muted)]">This should be resolved shortly.</p>
                </div>

                <div class="rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-surface-card)] p-4">
                  <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink-muted)]">Next step</p>
                  <p class="mt-2 font-headline text-[20px] text-[var(--color-ink)]">Retry after a moment</p>
                  <p class="mt-1 font-body-sm text-[var(--color-ink-muted)]">Reloading usually fixes transient issues.</p>
                </div>

                <div class="rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-surface-card)] p-4">
                  <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-ink-muted)]">Support</p>
                  <p class="mt-2 font-headline text-[20px] text-[var(--color-ink)]">Need help?</p>
                  <p class="mt-1 font-body-sm text-[var(--color-ink-muted)]">Visit the homepage or contact us.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
