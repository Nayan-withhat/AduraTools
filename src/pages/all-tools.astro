---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES } from '../data/categories';
import { TOOLS } from '../data/tools';
---

<Layout 
  title="All Online Tools — Complete Directory | AduraTools"
  description="Browse all 34+ free, fast, and private online tools for developers, text manipulation, math calculators, unit converters, and image processing."
>
  <div class="max-w-[1280px] mx-auto py-12 px-4 sm:px-6 lg:px-8 space-y-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="font-eyebrow text-[var(--color-ink-muted)]">Master Catalog</div>
      <h1 class="font-display-lg text-4xl sm:text-5xl text-[var(--color-ink)]">
        All 34+ Free Online Tools
      </h1>
      <p class="font-body text-[var(--color-ink-muted)]">
        Every tool is client-side, zero-telemetry, and lightning fast. Filter by category or search by keyword.
      </p>
    </div>

    <!-- Filter & Search Controls -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <!-- Live Instant Filter Input -->
        <div class="relative flex-1 w-full">
          <Icon name="search" class="w-4 h-4 text-[var(--color-ink-muted)] absolute left-4 top-1/2 -translate-y-1/2" />
          <input 
            type="text" 
            id="directory-filter-input" 
            placeholder="Filter tools by title, keyword, or action..." 
            class="input-base pl-11 py-3 text-sm bg-[var(--color-surface-card)]"
          />
        </div>

        <div class="font-mono text-xs text-[var(--color-ink-muted)] whitespace-nowrap">
          <span id="directory-count" class="font-bold text-[var(--color-ink)]">{TOOLS.length}</span> tools available
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-2">
        <button type="button" class="btn-dir-filter btn-primary text-xs py-1.5 px-3.5" data-category="all">All Tools</button>
        {CATEGORIES.map(cat => (
          <button type="button" class="btn-dir-filter btn-secondary text-xs py-1.5 px-3.5" data-category={cat.id}>
            {cat.name} ({cat.toolCount})
          </button>
        ))}
      </div>
    </div>

    <!-- Master Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="directory-grid">
      {TOOLS.map(tool => (
        <div class="directory-card-wrapper" data-category={tool.category} data-title={tool.name.toLowerCase()} data-tags={tool.tags.join(' ').toLowerCase()} data-desc={tool.shortDescription.toLowerCase()}>
          <ToolCard tool={tool} />
        </div>
      ))}
    </div>

    <!-- No results fallback -->
    <div id="directory-no-results" class="hidden p-12 text-center bg-[var(--color-surface-soft)] rounded-[var(--radius-lg)] border border-[var(--color-hairline)] space-y-3">
      <div class="w-12 h-12 rounded-full bg-[var(--color-surface-card)] border border-[var(--color-hairline)] flex items-center justify-center mx-auto text-neutral-400">
        <Icon name="search" class="w-6 h-6" />
      </div>
      <div class="font-sans font-bold text-lg text-[var(--color-ink)]">No tools matched your filter</div>
      <div class="font-body-sm text-sm text-neutral-500">Try searching for broader terms like "json", "convert", "image", or "math".</div>
    </div>
  </div>
</Layout>

<script>
  function initDirectoryFilter() {
    const input = document.getElementById('directory-filter-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.directory-card-wrapper') as NodeListOf<HTMLElement>;
    const countEl = document.getElementById('directory-count');
    const noResults = document.getElementById('directory-no-results');
    const filterButtons = document.querySelectorAll('.btn-dir-filter') as NodeListOf<HTMLButtonElement>;

    let activeCategory = 'all';

    function applyFilters() {
      const q = input?.value.trim().toLowerCase() || '';
      let visibleCount = 0;

      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const title = card.getAttribute('data-title') || '';
        const tags = card.getAttribute('data-tags') || '';
        const desc = card.getAttribute('data-desc') || '';

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesQuery = !q || title.includes(q) || tags.includes(q) || desc.includes(q);

        if (matchesCat && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countEl) countEl.textContent = visibleCount.toString();
      if (noResults) {
        if (visibleCount === 0) noResults.classList.remove('hidden');
        else noResults.classList.add('hidden');
      }
    }

    input?.addEventListener('input', applyFilters);

    filterButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        filterButtons.forEach(b => {
          b.classList.remove('btn-primary');
          b.classList.add('btn-secondary');
        });
        const target = e.currentTarget as HTMLElement;
        target.classList.add('btn-primary');
        target.classList.remove('btn-secondary');
        activeCategory = target.getAttribute('data-category') || 'all';
        applyFilters();
      });
    });

    applyFilters();
  }

  initDirectoryFilter();
  document.addEventListener('astro:page-load', initDirectoryFilter);
</script>
