---
import Layout from '../layouts/Layout.astro';
import MarqueeStrip from '../components/MarqueeStrip.astro';
import ToolCard from '../components/ToolCard.astro';
import ColorBlockSection from '../components/ColorBlockSection.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES } from '../data/categories';
import { getPopularTools } from '../data/tools';

const popularTools = getPopularTools().slice(0, 8);
---

<Layout 
  title="AduraTools — Fast, Free & Private Online Tools Platform"
  description="30+ free, fast, and privacy-first online tools for developers, text manipulation, math calculators, unit converters, image processing, and SEO utilities. 100% in-browser, no signups."
>
  <!-- HERO SECTION per DESIGN.md -->
  <section class="max-w-[1280px] mx-auto pt-16 pb-12 px-4 sm:px-6 lg:px-8 text-center space-y-6">
    <!-- Eyebrow Tag -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-surface-soft)] border border-[var(--color-hairline)]">
      <span class="w-2 h-2 rounded-full bg-[var(--color-semantic-success)] animate-pulse"></span>
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--color-ink)]">34+ Free In-Browser Tools</span>
    </div>

    <!-- Editorial Hero Title with Tight Negative Tracking -->
    <h1 class="font-display-xl text-[var(--color-ink)] max-w-4xl mx-auto">
      Every tool you need.<br class="hidden sm:inline" />
      <span class="font-normal text-neutral-500">Fast, free, and private.</span>
    </h1>

    <!-- Lead Subtitle -->
    <p class="font-body-lg text-neutral-500 max-w-2xl mx-auto leading-relaxed">
      A modern suite of utilities for text, developers, calculators, converters, and images. All processing happens in your browser — zero tracking, zero uploads, forever free.
    </p>

    <!-- Hero Search & Action Bar -->
    <div class="max-w-xl mx-auto pt-4 space-y-3">
      <button 
        type="button" 
        id="hero-search-trigger"
        class="w-full flex items-center justify-between p-3.5 sm:p-4 rounded-[50px] bg-[var(--color-surface-card)] border-2 border-[var(--color-hairline)] hover:border-[var(--color-ink)] shadow-lg shadow-black/5 transition-all text-left group cursor-pointer"
      >
        <span class="flex items-center gap-3 text-neutral-400 group-hover:text-[var(--color-ink)]">
          <Icon name="search" class="w-5 h-5 text-neutral-400 group-hover:text-[var(--color-ink)] transition-colors" />
          <span class="font-sans text-base font-medium">Search 34+ free tools (try 'json', 'diff', 'password')...</span>
        </span>
        <kbd class="hidden sm:inline-block font-mono text-xs px-2 py-1 rounded bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] text-neutral-400 font-semibold shadow-2xs">⌘K</kbd>
      </button>

      <!-- Quick Pill Shortcuts -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
        <span class="font-mono text-xs text-neutral-400">Popular:</span>
        <a href="/tools/json-formatter" class="font-sans text-xs px-3 py-1 rounded-full bg-[var(--color-surface-soft)] hover:bg-[var(--color-hairline)] border border-[var(--color-hairline)] text-[var(--color-ink)] text-decoration-none">JSON Formatter</a>
        <a href="/tools/word-counter" class="font-sans text-xs px-3 py-1 rounded-full bg-[var(--color-surface-soft)] hover:bg-[var(--color-hairline)] border border-[var(--color-hairline)] text-[var(--color-ink)] text-decoration-none">Word Counter</a>
        <a href="/tools/password-generator" class="font-sans text-xs px-3 py-1 rounded-full bg-[var(--color-surface-soft)] hover:bg-[var(--color-hairline)] border border-[var(--color-hairline)] text-[var(--color-ink)] text-decoration-none">Password Gen</a>
        <a href="/tools/image-compressor" class="font-sans text-xs px-3 py-1 rounded-full bg-[var(--color-surface-soft)] hover:bg-[var(--color-hairline)] border border-[var(--color-hairline)] text-[var(--color-ink)] text-decoration-none">Image Compressor</a>
        <a href="/tools/qr-code-generator" class="font-sans text-xs px-3 py-1 rounded-full bg-[var(--color-surface-soft)] hover:bg-[var(--color-hairline)] border border-[var(--color-hairline)] text-[var(--color-ink)] text-decoration-none">QR Codes</a>
      </div>
    </div>
  </section>

  <!-- MARQUEE STRIP -->
  <MarqueeStrip />

  <!-- POPULAR TOOLS SECTION -->
  <section class="max-w-[1280px] mx-auto py-16 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <div class="font-eyebrow text-neutral-400 mb-1">Curated Utilities</div>
        <h2 class="font-display-lg text-[var(--color-ink)]">Most Popular Tools</h2>
      </div>
      <a href="/all-tools" class="btn-secondary text-sm py-2 px-5 self-start sm:self-auto">
        Browse All 34+ Tools →
      </a>
    </div>

    <!-- Grid of Popular Tool Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {popularTools.map(tool => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>

  <!-- PASTEL COLOR BLOCK STORY SECTION 1: LIME (Systems & Features) -->
  <ColorBlockSection variant="lime">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-4">
        <div class="font-mono text-xs font-bold uppercase tracking-wider opacity-80">
          Client-Side Precision
        </div>
        <h2 class="font-sans font-bold text-3xl sm:text-4xl leading-tight tracking-tight">
          Tools that respect your privacy and never touch a remote server.
        </h2>
        <p class="font-body opacity-90 leading-relaxed text-base sm:text-lg">
          Unlike competitor platforms that upload sensitive files, customer payloads, and passwords to backend databases, every utility on AduraTools runs 100% locally inside your browser's JavaScript V8 runtime.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-black text-white dark:bg-white dark:text-black flex items-center justify-center text-xs font-bold">
              <Icon name="check" class="w-3 h-3" />
            </span>
            <span class="font-sans font-semibold text-sm">Zero Data Logging</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-black text-white dark:bg-white dark:text-black flex items-center justify-center text-xs font-bold">
              <Icon name="check" class="w-3 h-3" />
            </span>
            <span class="font-sans font-semibold text-sm">Sub-Millisecond Speed</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-black text-white dark:bg-white dark:text-black flex items-center justify-center text-xs font-bold">
              <Icon name="check" class="w-3 h-3" />
            </span>
            <span class="font-sans font-semibold text-sm">Works Offline</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 bg-white/90 dark:bg-black/60 backdrop-blur-xs p-6 rounded-[var(--radius-lg)] border border-black/10 dark:border-white/10 shadow-lg space-y-3 text-[var(--color-ink)]">
        <div class="font-mono text-xs font-bold uppercase text-neutral-400">Live Client Architecture</div>
        <div class="font-mono text-xs space-y-2 text-neutral-700 dark:text-neutral-300 bg-[var(--color-surface-soft)] p-3.5 rounded-lg border border-[var(--color-hairline)]">
          <div><span class="text-green-600 font-bold">&gt;</span> Memory Sandbox: Active</div>
          <div><span class="text-green-600 font-bold">&gt;</span> Network Payloads: 0 KB Transmitted</div>
          <div><span class="text-green-600 font-bold">&gt;</span> Cryptographic Entropy: 100% Native</div>
          <div><span class="text-green-600 font-bold">&gt;</span> Telemetry: Disabled</div>
        </div>
        <a href="/privacy" class="btn-primary w-full text-center text-xs py-2">
          Read Privacy Manifesto →
        </a>
      </div>
    </div>
  </ColorBlockSection>

  <!-- CATEGORIES BROWSE GRID -->
  <section class="max-w-[1280px] mx-auto py-16 px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
      <div class="font-eyebrow text-neutral-400">Full Taxonomy</div>
      <h2 class="font-display-lg text-[var(--color-ink)]">Explore by Category</h2>
      <p class="font-body text-neutral-500">
        Find the exact tool for your task across our organized categories.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {CATEGORIES.map(cat => (
        <a 
          href={`/categories/${cat.slug}`}
          class="group p-6 rounded-[var(--radius-lg)] border border-[var(--color-hairline)] hover:border-[var(--color-ink)] bg-[var(--color-surface-card)] transition-all duration-200 hover:-translate-y-1 hover:shadow-lg flex flex-col justify-between space-y-4 text-decoration-none"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div 
                class="w-12 h-12 rounded-xl flex items-center justify-center text-xl font-bold border border-black/10 dark:border-white/10 group-hover:scale-105 transition-transform"
                style={`background-color: ${cat.badgeBg}; color: #000000;`}
              >
                <Icon name={cat.icon} class="w-6 h-6" />
              </div>
              <span class="font-mono text-xs px-2.5 py-1 rounded-full bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] font-semibold text-neutral-500">
                {cat.toolCount} Tools
              </span>
            </div>

            <h3 class="font-card-title text-xl text-[var(--color-ink)]">
              {cat.name}
            </h3>
            <p class="font-body-sm text-sm text-neutral-500 leading-relaxed line-clamp-2">
              {cat.description}
            </p>
          </div>

          <div class="pt-3 border-t border-[var(--color-hairline-soft)] flex items-center justify-between text-xs font-semibold text-[var(--color-ink)]">
            <span>Explore Category</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- PASTEL COLOR BLOCK STORY SECTION 2: NAVY (Developer Power) -->
  <ColorBlockSection variant="navy">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-4 text-white">
        <div class="font-mono text-xs font-bold uppercase tracking-wider text-lime-300">
          Developer Workflow
        </div>
        <h2 class="font-sans font-bold text-3xl sm:text-4xl text-white leading-tight tracking-tight">
          Supercharge your workflow with instant presets and smart chaining.
        </h2>
        <p class="font-body text-neutral-300 leading-relaxed text-base sm:text-lg">
          No more empty, confusing inputs. Every AduraTools utility includes one-click sample presets, keyboard shortcut navigation (`⌘K`), line-number analyzers, and smart next-step suggestions.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="/all-tools" class="btn-primary bg-white text-black hover:bg-neutral-100 text-sm py-2 px-6">
            Explore Developer Suite
          </a>
          <a href="/tools/json-formatter" class="btn-secondary bg-transparent text-white border-white/30 hover:border-white text-sm py-2 px-5">
            Try JSON Formatter →
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 bg-black/40 border border-white/10 p-6 rounded-[var(--radius-lg)] space-y-3 font-mono text-xs text-neutral-300">
        <div class="text-lime-300 font-bold">// Instant Dev Workflow</div>
        <div class="p-3 bg-black/60 rounded border border-white/10 space-y-1">
          <div><span class="text-cyan-400">1.</span> Paste Minified Payload</div>
          <div><span class="text-cyan-400">2.</span> Auto-Format (2 Spaces)</div>
          <div><span class="text-cyan-400">3.</span> Validate JWT & Claims</div>
          <div><span class="text-cyan-400">4.</span> Copy with Toast Feedback</div>
        </div>
        <div class="text-neutral-400 text-[11px] pt-1">Result: Zero context switching, 100% offline ready.</div>
      </div>
    </div>
  </ColorBlockSection>

  <!-- FAQ SECTION (Pastel Cream) -->
  <ColorBlockSection variant="cream">
    <div class="max-w-3xl mx-auto space-y-6">
      <div class="text-center space-y-2">
        <div class="font-mono text-xs font-bold uppercase tracking-wider opacity-80">Help & Questions</div>
        <h2 class="font-display-lg">Frequently Asked Questions</h2>
      </div>

      <div class="space-y-4 pt-4 text-[var(--color-ink)]">
        <div class="p-5 bg-white/90 dark:bg-black/60 rounded-[var(--radius-md)] border border-black/10 dark:border-white/10 space-y-2">
          <h3 class="font-sans font-bold text-base">Is AduraTools really 100% free forever?</h3>
          <p class="font-body-sm text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Yes. Every tool on AduraTools is completely free to use without daily limits, subscription tiers, watermarks, or account registration walls.
          </p>
        </div>

        <div class="p-5 bg-white/90 dark:bg-black/60 rounded-[var(--radius-md)] border border-black/10 dark:border-white/10 space-y-2">
          <h3 class="font-sans font-bold text-base">Are my files, JSON payloads, or text uploaded to a server?</h3>
          <p class="font-body-sm text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            No! All transformations, text formatting, cryptographic hashing, and image compressions run entirely on your device using client-side JavaScript APIs (Web Crypto, Canvas, Web Workers).
          </p>
        </div>

        <div class="p-5 bg-white/90 dark:bg-black/60 rounded-[var(--radius-md)] border border-black/10 dark:border-white/10 space-y-2">
          <h3 class="font-sans font-bold text-base">Do tools work when I lose internet connection?</h3>
          <p class="font-body-sm text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Yes! Once a tool page is loaded in your browser, all processing happens locally, meaning it continues to function seamlessly even offline.
          </p>
        </div>
      </div>
    </div>
  </ColorBlockSection>

  <!-- CLOSING CALL TO ACTION SECTION -->
  <section class="max-w-[1280px] mx-auto py-16 px-4 sm:px-6 lg:px-8 text-center space-y-6">
    <h2 class="font-display-lg text-[var(--color-ink)]">
      Start using the toolkit built for speed.
    </h2>
    <p class="font-body text-neutral-500 max-w-xl mx-auto">
      No logins, no tracking, and no delays. Jump straight into the tools you need today.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
      <a href="/all-tools" class="btn-primary text-base py-2.5 px-7">
        Explore All 34+ Tools
      </a>
      <a href="/categories/developer-tools" class="btn-secondary text-base py-2.5 px-6">
        Developer Tools
      </a>
    </div>
  </section>
</Layout>

<script>
  function initHomeSearch() {
    const heroBtn = document.getElementById('hero-search-trigger');
    heroBtn?.addEventListener('click', () => {
      window.openCommandPalette?.();
    });
  }

  initHomeSearch();
  document.addEventListener('astro:page-load', initHomeSearch);
</script>
