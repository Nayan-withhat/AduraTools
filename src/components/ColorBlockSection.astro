---
interface Props {
  variant?: 'lime' | 'lilac' | 'cream' | 'pink' | 'mint' | 'coral' | 'navy';
  className?: string;
}

const { variant = 'lime', className = '' } = Astro.props;

const bgClassMap = {
  lime: 'bg-[var(--color-block-lime)] text-[var(--color-block-text-lime)]',
  lilac: 'bg-[var(--color-block-lilac)] text-[var(--color-block-text-lilac)]',
  cream: 'bg-[var(--color-block-cream)] text-[var(--color-block-text-cream)]',
  pink: 'bg-[var(--color-block-pink)] text-[var(--color-block-text-pink)]',
  mint: 'bg-[var(--color-block-mint)] text-[var(--color-block-text-mint)]',
  coral: 'bg-[var(--color-block-coral)] text-[var(--color-block-text-coral)]',
  navy: 'bg-[var(--color-block-navy)] text-[var(--color-block-text-navy)]',
};
---

<section class="max-w-[1280px] mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class={`color-block ${bgClassMap[variant]} ${className} border border-black/10 dark:border-white/10 shadow-sm`}>
    <slot />
  </div>
</section>
