---
import type { ToolItem } from '../data/tools';
import { getCategoryById } from '../data/categories';
import Icon from './Icon.astro';

interface Props {
  tool: ToolItem;
}

const { tool } = Astro.props;
const category = getCategoryById(tool.category);
---

<a 
  href={`/tools/${tool.slug}`}
  class="group flex flex-col justify-between p-5 rounded-[var(--radius-lg)] border border-[var(--color-hairline)] hover:border-[var(--color-ink)] bg-[var(--color-surface-card)] transition-all duration-200 hover:-translate-y-1 hover:shadow-lg text-decoration-none"
>
  <!-- Card Top: Category Eyebrow & Badges -->
  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <div class="w-9 h-9 rounded-lg bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] flex items-center justify-center text-[var(--color-ink)] group-hover:scale-105 transition-transform">
        <Icon name={tool.icon} class="w-4 h-4" />
      </div>
      
      {tool.badge && (
        <span class="font-mono text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-[#C7FF4D] text-black  border border-black/10">
          {tool.badge}
        </span>
      )}
    </div>

    <!-- Title & Description -->
    <div class="space-y-1.5">
      <div class="font-eyebrow text-neutral-400 text-[11px]">
        {category?.shortName || tool.category}
      </div>
      <h3 class="font-card-title text-base text-[var(--color-ink)] group-hover:text-[var(--color-ink)] transition-colors line-clamp-1">
        {tool.name}
      </h3>
      <p class="font-body-sm text-xs text-neutral-500 leading-relaxed line-clamp-2">
        {tool.shortDescription}
      </p>
    </div>
  </div>

  <!-- Card Bottom: Micro Action Indicator -->
  <div class="pt-4 mt-3 border-t border-[var(--color-hairline-soft)] flex items-center justify-between text-xs font-semibold text-[var(--color-ink)]">
    <span class="text-neutral-400 group-hover:text-[var(--color-ink)] transition-colors">Launch Tool</span>
    <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
  </div>
</a>
