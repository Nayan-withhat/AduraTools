---
import type { ToolItem } from '../../data/tools';
import Icon from '../Icon.astro';

interface Props {
  tool: ToolItem;
}
const { tool } = Astro.props;
---

<div class="space-y-4" id="json-formatter-root">
  <!-- Action Controls Toolbar -->
  <div class="flex flex-wrap items-center justify-between gap-3 p-3 bg-[var(--color-surface-soft)] rounded-[var(--radius-md)] border border-[var(--color-hairline)]">
    <!-- Format Action Buttons -->
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" id="btn-format-2" class="btn-primary text-xs py-1.5 px-3.5 flex items-center gap-1.5">
        <Icon name="code" class="w-3.5 h-3.5" />
        <span>Format (2 Spaces)</span>
      </button>
      <button type="button" id="btn-format-4" class="btn-secondary text-xs py-1.5 px-3.5">
        Format (4 Spaces)
      </button>
      <button type="button" id="btn-minify" class="btn-secondary text-xs py-1.5 px-3.5 flex items-center gap-1.5">
        <Icon name="minifier" class="w-3.5 h-3.5" />
        <span>Minify JSON</span>
      </button>
    </div>

    <!-- Utility Buttons -->
    <div class="flex items-center gap-2">
      <button type="button" id="btn-load-sample" class="btn-secondary text-xs py-1.5 px-3 flex items-center gap-1.5">
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        <span>Load Sample</span>
      </button>
      <button type="button" id="btn-clear" class="btn-secondary text-xs py-1.5 px-3 text-red-500 hover:text-red-600 flex items-center gap-1.5">
        <Icon name="trash" class="w-3.5 h-3.5" />
        <span>Clear</span>
      </button>
    </div>
  </div>

  <!-- Dual-Pane Editor Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <!-- Input Editor -->
    <div class="flex flex-col space-y-2">
      <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
        <span class="font-bold uppercase tracking-wider text-[var(--color-ink)]">Input JSON Payload</span>
        <span id="input-stats">0 chars</span>
      </div>
      <div class="relative flex-1">
        <textarea 
          id="json-input" 
          rows="16" 
          placeholder="Paste unformatted or minified JSON here..." 
          class="input-base textarea-code w-full h-full min-h-[320px] p-4 bg-[var(--color-surface-card)] text-[var(--color-ink)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] resize-y outline-none"
        >{tool.sampleInput || ''}</textarea>
      </div>
    </div>

    <!-- Output Editor -->
    <div class="flex flex-col space-y-2">
      <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
        <div class="flex items-center gap-2">
          <span class="font-bold uppercase tracking-wider text-[var(--color-ink)]">Formatted Output</span>
          <span id="validation-badge" class="px-2 py-0.5 rounded-full bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300 font-semibold text-[10px]">
            Valid JSON
          </span>
        </div>
        <button type="button" id="btn-copy-output" class="btn-primary text-xs py-1 px-3 flex items-center gap-1.5">
          <Icon name="copy" class="w-3 h-3" />
          <span>Copy</span>
        </button>
      </div>
      <div class="relative flex-1">
        <textarea 
          id="json-output" 
          rows="16" 
          readonly 
          placeholder="Formatted JSON will appear here..." 
          class="input-base textarea-code w-full h-full min-h-[320px] p-4 bg-[var(--color-surface-soft)] text-[var(--color-ink)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] resize-y outline-none"
        ></textarea>
      </div>
    </div>
  </div>

  <!-- Status & Error Bar -->
  <div id="json-error-bar" class="hidden p-3 rounded-[var(--radius-md)] bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300 font-mono text-xs border border-red-200 dark:border-red-800 flex items-center gap-2">
    <Icon name="shield" class="w-4 h-4 text-red-500 shrink-0" />
    <span id="json-error-text">Syntax error details will appear here.</span>
  </div>
</div>

<script>
  function setupJsonFormatter() {
    const input = document.getElementById('json-input') as HTMLTextAreaElement | null;
    const output = document.getElementById('json-output') as HTMLTextAreaElement | null;
    const stats = document.getElementById('input-stats');
    const badge = document.getElementById('validation-badge');
    const errorBar = document.getElementById('json-error-bar');
    const errorText = document.getElementById('json-error-text');

    const btn2 = document.getElementById('btn-format-2');
    const btn4 = document.getElementById('btn-format-4');
    const btnMin = document.getElementById('btn-minify');
    const btnSample = document.getElementById('btn-load-sample');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy-output');

    if (!input || !output) return;

    function format(spaces: number | null) {
      const raw = input.value.trim();
      if (stats) stats.textContent = `${raw.length} chars`;

      if (!raw) {
        output.value = '';
        if (badge) {
          badge.textContent = 'Empty';
          badge.className = 'px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-500 text-[10px]';
        }
        if (errorBar) errorBar.classList.add('hidden');
        return;
      }

      try {
        const parsed = JSON.parse(raw);
        const res = spaces === null ? JSON.stringify(parsed) : JSON.stringify(parsed, null, spaces);
        output.value = res;

        if (badge) {
          badge.textContent = 'Valid JSON';
          badge.className = 'px-2 py-0.5 rounded-full bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300 font-semibold text-[10px]';
        }
        if (errorBar) errorBar.classList.add('hidden');
      } catch (err: any) {
        output.value = '';
        if (badge) {
          badge.textContent = 'Invalid JSON';
          badge.className = 'px-2 py-0.5 rounded-full bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300 font-semibold text-[10px]';
        }
        if (errorBar && errorText) {
          errorText.textContent = err.message;
          errorBar.classList.remove('hidden');
        }
      }
    }

    btn2?.addEventListener('click', () => format(2));
    btn4?.addEventListener('click', () => format(4));
    btnMin?.addEventListener('click', () => format(null));
    input.addEventListener('input', () => format(2));

    btnSample?.addEventListener('click', () => {
      input.value = JSON.stringify({
        project: "AduraTools",
        domain: "aduratools.site",
        version: "2.0.0",
        features: ["zero-telemetry", "client-side-v8", "offline-ready"],
        metrics: { speedMs: 0.4, serverRequests: 0 }
      }, null, 2);
      format(2);
      window.showToast?.('Sample JSON loaded');
    });

    btnClear?.addEventListener('click', () => {
      input.value = '';
      output.value = '';
      format(2);
      input.focus();
    });

    btnCopy?.addEventListener('click', () => {
      if (!output.value) return;
      navigator.clipboard.writeText(output.value);
      window.showToast?.('Formatted JSON copied to clipboard!');
    });

    format(2);
  }

  setupJsonFormatter();
  document.addEventListener('astro:page-load', setupJsonFormatter);
</script>
