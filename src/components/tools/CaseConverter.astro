---
import type { ToolItem } from '../../data/tools';
import Icon from '../Icon.astro';

interface Props {
  tool: ToolItem;
}
const { tool } = Astro.props;

const formatTypes = [
  { id: 'upper', label: 'UPPERCASE', example: 'HELLO WORLD' },
  { id: 'lower', label: 'lowercase', example: 'hello world' },
  { id: 'title', label: 'Title Case', example: 'Hello World' },
  { id: 'sentence', label: 'Sentence case', example: 'Hello world' },
  { id: 'camel', label: 'camelCase', example: 'helloWorld' },
  { id: 'pascal', label: 'PascalCase', example: 'HelloWorld' },
  { id: 'snake', label: 'snake_case', example: 'hello_world' },
  { id: 'kebab', label: 'kebab-case', example: 'hello-world' },
  { id: 'constant', label: 'CONSTANT_CASE', example: 'HELLO_WORLD' },
  { id: 'alternating', label: 'aLtErNaTiNg cAsE', example: 'hElLo wOrLd' }
];
---

<div class="space-y-6" id="case-converter-root">
  <!-- Input Area -->
  <div class="space-y-2">
    <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
      <span class="font-bold uppercase tracking-wider text-[var(--color-ink)]">Input Text</span>
      <div class="flex items-center gap-2">
        <button type="button" id="btn-load-sample" class="btn-secondary text-xs py-1 px-3 flex items-center gap-1.5">
          <Icon name="sparkles" class="w-3.5 h-3.5" />
          <span>Load Sample</span>
        </button>
        <button type="button" id="btn-clear" class="btn-secondary text-xs py-1 px-3 text-red-500 hover:text-red-600 flex items-center gap-1.5">
          <Icon name="trash" class="w-3.5 h-3.5" />
          <span>Clear</span>
        </button>
      </div>
    </div>
    <textarea 
      id="case-input" 
      rows="4" 
      placeholder="Type or paste text to convert across 10 casing conventions..." 
      class="input-base w-full p-4 bg-[var(--color-surface-card)] text-[var(--color-ink)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] leading-relaxed resize-y outline-none font-sans text-base"
    >{tool.sampleInput || ''}</textarea>
  </div>

  <!-- Real-time 10-Case Transformation Tiles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {formatTypes.map(fmt => (
      <div class="p-4 rounded-[var(--radius-lg)] bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] space-y-2 hover:border-[var(--color-ink)] transition-colors group">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs uppercase font-bold text-neutral-400">{fmt.label}</span>
          <button 
            type="button" 
            class="btn-copy-format btn-primary text-xs py-1 px-2.5 flex items-center gap-1 opacity-80 group-hover:opacity-100 transition-opacity"
            data-target={fmt.id}
          >
            <Icon name="copy" class="w-3 h-3" />
            <span>Copy</span>
          </button>
        </div>
        <div 
          id={`case-out-${fmt.id}`} 
          class="font-mono text-sm font-semibold text-[var(--color-ink)] bg-[var(--color-surface-card)] p-3 rounded-[var(--radius-md)] border border-[var(--color-hairline)] break-all min-h-[44px] flex items-center"
        >
          {fmt.example}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  function initCaseConverter() {
    const input = document.getElementById('case-input') as HTMLTextAreaElement | null;
    const btnSample = document.getElementById('btn-load-sample');
    const btnClear = document.getElementById('btn-clear');
    const copyBtns = document.querySelectorAll('.btn-copy-format') as NodeListOf<HTMLButtonElement>;

    if (!input) return;

    function toWords(str: string): string[] {
      return str
        .replace(/([a-z])([A-Z])/g, '$1 $2')
        .replace(/[-_]+/g, ' ')
        .trim()
        .split(/\s+/)
        .filter(Boolean);
    }

    function convert() {
      const raw = input.value.trim();

      const formats: Record<string, string> = {
        upper: raw.toUpperCase(),
        lower: raw.toLowerCase(),
        title: raw.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase()),
        sentence: raw.toLowerCase().replace(/(^\s*\w|[.!?]\s*\w)/g, (c) => c.toUpperCase()),
        camel: toWords(raw).map((w, i) => i === 0 ? w.toLowerCase() : w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(''),
        pascal: toWords(raw).map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(''),
        snake: toWords(raw).map(w => w.toLowerCase()).join('_'),
        kebab: toWords(raw).map(w => w.toLowerCase()).join('-'),
        constant: toWords(raw).map(w => w.toUpperCase()).join('_'),
        alternating: raw.split('').map((c, i) => i % 2 === 0 ? c.toLowerCase() : c.toUpperCase()).join('')
      };

      Object.entries(formats).forEach(([id, val]) => {
        const el = document.getElementById(`case-out-${id}`);
        if (el) el.textContent = val || '...';
      });
    }

    input.addEventListener('input', convert);

    btnSample?.addEventListener('click', () => {
      input.value = 'adura tools fast free privacy web platform';
      convert();
      window.showToast?.('Sample loaded');
    });

    btnClear?.addEventListener('click', () => {
      input.value = '';
      convert();
      input.focus();
    });

    copyBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetId = (e.currentTarget as HTMLElement).getAttribute('data-target');
        const textEl = document.getElementById(`case-out-${targetId}`);
        if (textEl && textEl.textContent && textEl.textContent !== '...') {
          navigator.clipboard.writeText(textEl.textContent);
          window.showToast?.('Copied to clipboard!');
        }
      });
    });

    convert();
  }

  initCaseConverter();
  document.addEventListener('astro:page-load', initCaseConverter);
</script>
