---
import type { ToolItem } from '../../data/tools';
import Icon from '../Icon.astro';

interface Props {
  tool: ToolItem;
}
const { tool } = Astro.props;
---

<div class="space-y-6" id="img-compress-root">
  <!-- Upload Dropzone -->
  <div 
    id="drop-zone" 
    class="p-8 border-2 border-dashed border-[var(--color-hairline)] rounded-[var(--radius-lg)] bg-[var(--color-surface-soft)] hover:border-[var(--color-ink)] transition-colors text-center cursor-pointer space-y-3"
  >
    <div class="w-12 h-12 rounded-full bg-[var(--color-surface-card)] border border-[var(--color-hairline)] flex items-center justify-center mx-auto text-[var(--color-ink)] shadow-xs">
      <Icon name="image" class="w-6 h-6 text-neutral-400" />
    </div>
    <div>
      <div class="font-sans font-bold text-base text-[var(--color-ink)]">Drag & drop your image here, or browse</div>
      <div class="font-mono text-xs text-neutral-400 mt-1">Supports PNG, JPEG, and WebP up to 50MB (100% processed in browser)</div>
    </div>
    <input type="file" id="file-input" accept="image/*" class="hidden" />
    <button type="button" id="btn-browse" class="btn-primary text-xs py-2 px-5 mt-2">
      Select Image File
    </button>
  </div>

  <!-- Compression Configuration & Results (Hidden until file selected) -->
  <div id="result-container" class="hidden space-y-6">
    <!-- Controls Row -->
    <div class="p-5 rounded-[var(--radius-lg)] bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] space-y-4">
      <div class="flex items-center justify-between">
        <span class="font-sans font-bold text-sm text-[var(--color-ink)]">Compression Quality</span>
        <span id="quality-val" class="font-mono text-sm font-bold text-[var(--color-ink)] px-2 py-0.5 rounded bg-[var(--color-surface-card)] border border-[var(--color-hairline)]">75%</span>
      </div>
      <input 
        type="range" 
        id="quality-slider" 
        min="10" 
        max="100" 
        value="75" 
        class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-[var(--color-primary)]"
      />
      <div class="flex justify-between text-[11px] font-mono text-neutral-400">
        <span>Smallest Size (10%)</span>
        <span>Balanced (75% Recommended)</span>
        <span>Highest Quality (100%)</span>
      </div>
    </div>

    <!-- Comparison Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Original Image -->
      <div class="p-4 rounded-[var(--radius-lg)] bg-[var(--color-surface-card)] border border-[var(--color-hairline)] space-y-3">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
          <span class="font-bold uppercase text-[var(--color-ink)]">Original</span>
          <span id="orig-size" class="font-bold">0 KB</span>
        </div>
        <div class="w-full h-48 bg-[var(--color-surface-soft)] rounded-[var(--radius-md)] flex items-center justify-center overflow-hidden border border-[var(--color-hairline)]">
          <img id="orig-preview" src="" alt="Original Preview" class="max-h-full max-w-full object-contain" />
        </div>
      </div>

      <!-- Compressed Image -->
      <div class="p-4 rounded-[var(--radius-lg)] bg-[var(--color-surface-card)] border border-[var(--color-hairline)] space-y-3">
        <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
          <div class="flex items-center gap-2">
            <span class="font-bold uppercase text-[var(--color-ink)]">Compressed</span>
            <span id="savings-badge" class="px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-950/50 text-green-800 dark:text-green-300 font-bold text-[10px]">-0%</span>
          </div>
          <span id="comp-size" class="font-bold text-green-600 dark:text-green-400">0 KB</span>
        </div>
        <div class="w-full h-48 bg-[var(--color-surface-soft)] rounded-[var(--radius-md)] flex items-center justify-center overflow-hidden border border-[var(--color-hairline)]">
          <img id="comp-preview" src="" alt="Compressed Preview" class="max-h-full max-w-full object-contain" />
        </div>
      </div>
    </div>

    <!-- Download CTA -->
    <div class="flex justify-end gap-3 pt-2">
      <button type="button" id="btn-download-compressed" class="btn-primary text-sm py-2.5 px-6 flex items-center gap-2">
        <Icon name="arrow-right" class="w-4 h-4" />
        <span>Download Optimized Image</span>
      </button>
    </div>
  </div>
</div>

<script>
  function initImageCompressor() {
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const btnBrowse = document.getElementById('btn-browse');
    const resultContainer = document.getElementById('result-container');

    const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement | null;
    const qualityVal = document.getElementById('quality-val');

    const origPreview = document.getElementById('orig-preview') as HTMLImageElement | null;
    const compPreview = document.getElementById('comp-preview') as HTMLImageElement | null;
    const origSizeEl = document.getElementById('orig-size');
    const compSizeEl = document.getElementById('comp-size');
    const savingsBadge = document.getElementById('savings-badge');
    const btnDownload = document.getElementById('btn-download-compressed');

    let rawImage: HTMLImageElement | null = null;
    let originalFile: File | null = null;
    let compressedBlob: Blob | null = null;

    if (!fileInput || !dropZone) return;

    function formatBytes(bytes: number): string {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function handleFile(file: File) {
      if (!file.type.startsWith('image/')) {
        window.showToast?.('Please upload an image file (PNG, JPG, WebP)', 'error');
        return;
      }

      originalFile = file;
      if (origSizeEl) origSizeEl.textContent = formatBytes(file.size);

      const reader = new FileReader();
      reader.onload = (e) => {
        const src = e.target?.result as string;
        if (origPreview) origPreview.src = src;

        const img = new Image();
        img.src = src;
        img.onload = () => {
          rawImage = img;
          if (resultContainer) resultContainer.classList.remove('hidden');
          compressImage();
        };
      };
      reader.readAsDataURL(file);
    }

    function compressImage() {
      if (!rawImage || !originalFile) return;

      const quality = parseInt(qualitySlider?.value || '75', 10) / 100;
      if (qualityVal) qualityVal.textContent = `${Math.round(quality * 100)}%`;

      const canvas = document.createElement('canvas');
      canvas.width = rawImage.naturalWidth;
      canvas.height = rawImage.naturalHeight;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.drawImage(rawImage, 0, 0);

      const mime = originalFile.type === 'image/png' ? 'image/webp' : originalFile.type;
      canvas.toBlob((blob) => {
        if (!blob) return;
        compressedBlob = blob;
        if (compSizeEl) compSizeEl.textContent = formatBytes(blob.size);

        if (compPreview) {
          compPreview.src = URL.createObjectURL(blob);
        }

        const saved = originalFile!.size - blob.size;
        const pctSaved = Math.round((saved / originalFile!.size) * 100);

        if (savingsBadge) {
          if (pctSaved > 0) {
            savingsBadge.textContent = `-${pctSaved}% Saved`;
            savingsBadge.className = 'px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-950/50 text-green-800 dark:text-green-300 font-bold text-[10px]';
          } else {
            savingsBadge.textContent = 'Best Quality';
            savingsBadge.className = 'px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-500 font-bold text-[10px]';
          }
        }
      }, mime, quality);
    }

    btnBrowse?.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-[var(--color-ink)]', 'bg-[var(--color-surface-card)]');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-[var(--color-ink)]', 'bg-[var(--color-surface-card)]');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-[var(--color-ink)]', 'bg-[var(--color-surface-card)]');
      if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        handleFile(fileInput.files[0]);
      }
    });

    qualitySlider?.addEventListener('input', compressImage);

    btnDownload?.addEventListener('click', () => {
      if (!compressedBlob || !originalFile) return;
      const a = document.createElement('a');
      const ext = compressedBlob.type === 'image/webp' ? 'webp' : 'jpg';
      const name = originalFile.name.replace(/\.[^/.]+$/, '');
      a.download = `${name}-optimized.${ext}`;
      a.href = URL.createObjectURL(compressedBlob);
      a.click();
      window.showToast?.('Optimized image downloaded!');
    });
  }

  initImageCompressor();
  document.addEventListener('astro:page-load', initImageCompressor);
</script>
