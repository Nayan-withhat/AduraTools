---
import type { ToolItem } from '../../data/tools';
import Icon from '../Icon.astro';

interface Props {
  tool: ToolItem;
}
const { tool } = Astro.props;
---

<div class="space-y-6" id="generic-tool-root" data-slug={tool.slug}>
  <!-- Actions Toolbar -->
  <div class="flex flex-wrap items-center justify-between gap-3 p-3 bg-[var(--color-surface-soft)] rounded-[var(--radius-md)] border border-[var(--color-hairline)]">
    <div class="flex items-center gap-2">
      <button type="button" id="btn-run-action" class="btn-primary text-xs py-1.5 px-4 flex items-center gap-1.5">
        <Icon name="play" class="w-3.5 h-3.5" />
        <span>Execute / Run</span>
      </button>
      <span id="gen-status-badge" class="font-mono text-xs px-2.5 py-0.5 rounded-full bg-[var(--color-surface-card)] border border-[var(--color-hairline)] text-neutral-400">
        Ready
      </span>
    </div>
    <div class="flex items-center gap-2">
      {tool.sampleInput && (
        <button type="button" id="btn-load-sample" class="btn-secondary text-xs py-1.5 px-3 flex items-center gap-1.5">
          <Icon name="sparkles" class="w-3.5 h-3.5" />
          <span>Load Sample</span>
        </button>
      )}
      <button type="button" id="btn-clear-all" class="btn-secondary text-xs py-1.5 px-3 text-red-500 hover:text-red-600 flex items-center gap-1.5">
        <Icon name="trash" class="w-3.5 h-3.5" />
        <span>Clear</span>
      </button>
    </div>
  </div>

  <!-- Dual Input / Output Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Input Pane -->
    <div class="flex flex-col space-y-2">
      <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
        <span class="font-bold uppercase tracking-wider text-[var(--color-ink)]">Input</span>
        <span id="gen-input-counter">0 chars</span>
      </div>
      <textarea 
        id="gen-input" 
        rows="12" 
        placeholder="Enter or paste input here..." 
        class="input-base textarea-code flex-1 font-mono text-sm leading-relaxed p-4 bg-[var(--color-surface-card)] text-[var(--color-ink)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] resize-y outline-none"
      >{tool.sampleInput || ''}</textarea>
    </div>

    <!-- Output Pane -->
    <div class="flex flex-col space-y-2">
      <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
        <span class="font-bold uppercase tracking-wider text-[var(--color-ink)]">Output Result</span>
        <button type="button" id="btn-copy-gen" class="btn-primary text-xs py-1 px-3 flex items-center gap-1.5">
          <Icon name="copy" class="w-3 h-3" />
          <span>Copy</span>
        </button>
      </div>
      <textarea 
        id="gen-output" 
        rows="12" 
        readonly 
        placeholder="Output will appear here automatically..." 
        class="input-base textarea-code flex-1 font-mono text-sm leading-relaxed p-4 bg-[var(--color-surface-soft)] text-[var(--color-ink)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] resize-y outline-none"
      ></textarea>
    </div>
  </div>
</div>

<script>
  function initGenericRunner() {
    const root = document.getElementById('generic-tool-root');
    const slug = root?.getAttribute('data-slug');
    const input = document.getElementById('gen-input') as HTMLTextAreaElement | null;
    const output = document.getElementById('gen-output') as HTMLTextAreaElement | null;
    const counter = document.getElementById('gen-input-counter');
    const badge = document.getElementById('gen-status-badge');
    const btnRun = document.getElementById('btn-run-action');
    const btnSample = document.getElementById('btn-load-sample');
    const btnClear = document.getElementById('btn-clear-all');
    const btnCopy = document.getElementById('btn-copy-gen');

    if (!input || !output || !slug) return;

    async function calcHash(algo: string, text: string): Promise<string> {
      const msgUint8 = new TextEncoder().encode(text);
      const hashBuffer = await crypto.subtle.digest(algo, msgUint8);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    async function processTool() {
      const raw = input?.value || '';
      if (counter) counter.textContent = `${raw.length} chars`;

      if (badge) {
        badge.textContent = 'Processing...';
        badge.className = 'font-mono text-xs px-2.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950/50 text-amber-800 dark:text-amber-300';
      }

      let result = '';

      switch (slug) {
        case 'slug-generator': {
          result = raw
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
          break;
        }

        case 'duplicate-remover': {
          const lines = raw.split(/\r\n|\r|\n/);
          const unique = Array.from(new Set(lines.filter(l => l.trim().length > 0)));
          result = unique.join('\n');
          if (badge) badge.textContent = `${lines.length} lines → ${unique.length} unique`;
          break;
        }

        case 'whitespace-remover': {
          result = raw
            .replace(/[ \t]+/g, ' ')
            .replace(/\n\s*\n/g, '\n')
            .trim();
          break;
        }

        case 'text-reverser': {
          result = raw.split('').reverse().join('');
          break;
        }

        case 'uuid-generator': {
          const count = 5;
          const uuids = Array.from({ length: count }, () => crypto.randomUUID());
          result = uuids.join('\n');
          break;
        }

        case 'timestamp-converter': {
          const val = raw.trim();
          if (/^\d+$/.test(val)) {
            const ms = val.length === 10 ? parseInt(val) * 1000 : parseInt(val);
            const date = new Date(ms);
            result = `UTC: ${date.toUTCString()}\nLocal: ${date.toString()}\nISO 8601: ${date.toISOString()}\nRelative: ${Math.round((Date.now() - ms) / 1000)} seconds ago`;
          } else {
            const date = new Date(val);
            result = isNaN(date.getTime()) 
              ? 'Invalid Date Format' 
              : `Epoch Seconds: ${Math.floor(date.getTime() / 1000)}\nEpoch Milliseconds: ${date.getTime()}`;
          }
          break;
        }

        case 'lorem-ipsum': {
          result = `Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.\n\nDuis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.`;
          break;
        }

        case 'url-encoder': {
          result = encodeURIComponent(raw);
          break;
        }

        case 'html-entity-encoder': {
          result = raw
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
          break;
        }

        case 'hash-generator': {
          try {
            const sha256 = await calcHash('SHA-256', raw);
            const sha512 = await calcHash('SHA-512', raw);
            const sha1 = await calcHash('SHA-1', raw);
            result = `SHA-256:\n${sha256}\n\nSHA-512:\n${sha512}\n\nSHA-1:\n${sha1}`;
          } catch {
            result = 'Hash generation requires Web Crypto API';
          }
          break;
        }

        case 'jwt-decoder': {
          try {
            const parts = raw.trim().split('.');
            if (parts.length >= 2) {
              const header = JSON.parse(atob(parts[0]));
              const payload = JSON.parse(atob(parts[1]));
              result = `HEADER:\n${JSON.stringify(header, null, 2)}\n\nPAYLOAD CLAIMS:\n${JSON.stringify(payload, null, 2)}`;
            } else {
              result = 'Invalid JWT format (expected 3 dot-separated segments)';
            }
          } catch (e: any) {
            result = `JWT Error: ${e.message}`;
          }
          break;
        }

        case 'number-base-converter': {
          const num = parseInt(raw.trim(), 10);
          if (isNaN(num)) {
            result = 'Enter a valid decimal number (e.g. 255)';
          } else {
            result = `Decimal: ${num.toString(10)}\nBinary: ${num.toString(2)}\nHexadecimal: 0x${num.toString(16).toUpperCase()}\nOctal: ${num.toString(8)}`;
          }
          break;
        }

        case 'css-js-minifier': {
          result = raw
            .replace(/\/\*[\s\S]*?\*\/|([^:]|^)\/\/.*$/gm, '')
            .replace(/\s+/g, ' ')
            .replace(/\s*([;{}:,])\s*/g, '$1')
            .trim();
          break;
        }

        case 'robots-txt-generator': {
          result = `# robots.txt for aduratools.site\nUser-agent: *\nAllow: /\nDisallow: /admin/\nDisallow: /api/\n\nSitemap: https://aduratools.site/sitemap.xml`;
          break;
        }

        default: {
          result = raw;
          break;
        }
      }

      output.value = result;
      if (badge && slug !== 'duplicate-remover') {
        badge.textContent = 'Completed';
        badge.className = 'font-mono text-xs px-2.5 py-0.5 rounded-full bg-green-100 dark:bg-green-950/50 text-green-800 dark:text-green-300 font-semibold';
      }
    }

    input.addEventListener('input', () => processTool());
    btnRun?.addEventListener('click', () => processTool());

    btnSample?.addEventListener('click', () => {
      processTool();
      window.showToast?.('Sample loaded & executed');
    });

    btnClear?.addEventListener('click', () => {
      input.value = '';
      output.value = '';
      if (counter) counter.textContent = '0 chars';
      if (badge) badge.textContent = 'Ready';
      input.focus();
    });

    btnCopy?.addEventListener('click', () => {
      if (!output.value) return;
      navigator.clipboard.writeText(output.value);
      window.showToast?.('Output copied to clipboard!');
    });

    processTool();
  }

  initGenericRunner();
  document.addEventListener('astro:page-load', initGenericRunner);
</script>
