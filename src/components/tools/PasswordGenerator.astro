---
import type { ToolItem } from '../../data/tools';
import Icon from '../Icon.astro';

interface Props {
  tool: ToolItem;
}
const { tool } = Astro.props;
---

<div class="space-y-6" id="password-generator-root">
  <!-- Generated Password Display Box -->
  <div class="p-6 rounded-[var(--radius-lg)] bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] space-y-4">
    <div class="flex items-center justify-between">
      <span class="font-mono text-xs uppercase font-bold text-neutral-400">Generated Password</span>
      <span id="entropy-badge" class="px-2.5 py-0.5 rounded-full bg-green-100 text-green-800 dark:bg-green-950/50 dark:text-green-300 font-bold text-xs">
        Very Strong (96 Bits)
      </span>
    </div>

    <!-- Password String & Copy Button -->
    <div class="flex items-center gap-3">
      <input 
        type="text" 
        id="password-output" 
        readonly 
        value="" 
        class="flex-1 font-mono text-lg sm:text-2xl font-bold tracking-wider p-4 bg-[var(--color-surface-card)] text-[var(--color-ink)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] outline-none shadow-xs select-all"
      />
      <button 
        type="button" 
        id="btn-regenerate" 
        class="btn-secondary h-14 px-4 flex items-center justify-center gap-1.5"
        title="Regenerate"
      >
        <Icon name="refresh" class="w-5 h-5" />
      </button>
      <button 
        type="button" 
        id="btn-copy-pass" 
        class="btn-primary h-14 px-6 flex items-center justify-center gap-2 text-sm font-semibold whitespace-nowrap"
      >
        <Icon name="copy" class="w-4 h-4" />
        <span>Copy</span>
      </button>
    </div>

    <!-- Strength Meter Bar -->
    <div class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-full overflow-hidden">
      <div id="strength-bar" class="h-full bg-[var(--color-semantic-success)] transition-all duration-300" style="width: 85%;"></div>
    </div>
  </div>

  <!-- Settings & Customization Controls -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 rounded-[var(--radius-lg)] bg-[var(--color-surface-card)] border border-[var(--color-hairline)]">
    <!-- Length Slider -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <label class="font-sans font-semibold text-sm text-[var(--color-ink)]">Password Length</label>
        <span id="length-val" class="font-mono text-sm font-bold text-[var(--color-ink)] px-2 py-0.5 rounded bg-[var(--color-surface-soft)] border border-[var(--color-hairline)]">16</span>
      </div>
      <input 
        type="range" 
        id="pass-length" 
        min="8" 
        max="64" 
        value="16" 
        class="w-full h-2 bg-neutral-200 dark:bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-[var(--color-primary)]"
      />
      <div class="flex justify-between text-[11px] font-mono text-neutral-400">
        <span>8 chars</span>
        <span>16 (Recommended)</span>
        <span>64 chars</span>
      </div>
    </div>

    <!-- Character Options Checkboxes -->
    <div class="space-y-3">
      <label class="font-sans font-semibold text-sm text-[var(--color-ink)]">Character Sets</label>
      <div class="grid grid-cols-2 gap-3">
        <label class="flex items-center gap-2 text-xs font-sans text-neutral-600 dark:text-neutral-300 cursor-pointer">
          <input type="checkbox" id="opt-upper" checked class="rounded border-neutral-300 accent-[var(--color-primary)] w-4 h-4" />
          <span>Uppercase (A-Z)</span>
        </label>
        <label class="flex items-center gap-2 text-xs font-sans text-neutral-600 dark:text-neutral-300 cursor-pointer">
          <input type="checkbox" id="opt-lower" checked class="rounded border-neutral-300 accent-[var(--color-primary)] w-4 h-4" />
          <span>Lowercase (a-z)</span>
        </label>
        <label class="flex items-center gap-2 text-xs font-sans text-neutral-600 dark:text-neutral-300 cursor-pointer">
          <input type="checkbox" id="opt-nums" checked class="rounded border-neutral-300 accent-[var(--color-primary)] w-4 h-4" />
          <span>Numbers (0-9)</span>
        </label>
        <label class="flex items-center gap-2 text-xs font-sans text-neutral-600 dark:text-neutral-300 cursor-pointer">
          <input type="checkbox" id="opt-syms" checked class="rounded border-neutral-300 accent-[var(--color-primary)] w-4 h-4" />
          <span>Symbols (!@#$%)</span>
        </label>
      </div>
    </div>
  </div>
</div>

<script>
  function initPasswordGenerator() {
    const out = document.getElementById('password-output') as HTMLInputElement | null;
    const slider = document.getElementById('pass-length') as HTMLInputElement | null;
    const lenVal = document.getElementById('length-val');
    const badge = document.getElementById('entropy-badge');
    const bar = document.getElementById('strength-bar');

    const optUpper = document.getElementById('opt-upper') as HTMLInputElement | null;
    const optLower = document.getElementById('opt-lower') as HTMLInputElement | null;
    const optNums = document.getElementById('opt-nums') as HTMLInputElement | null;
    const optSyms = document.getElementById('opt-syms') as HTMLInputElement | null;

    const btnRegen = document.getElementById('btn-regenerate');
    const btnCopy = document.getElementById('btn-copy-pass');

    if (!out || !slider) return;

    const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const LOWER = 'abcdefghijklmnopqrstuvwxyz';
    const NUMS = '0123456789';
    const SYMS = '!@#$%^&*()_+-=[]{}|;:,.<>?';

    function generate() {
      const length = parseInt(slider?.value || '16', 10);
      if (lenVal) lenVal.textContent = length.toString();

      let charset = '';
      if (optUpper?.checked) charset += UPPER;
      if (optLower?.checked) charset += LOWER;
      if (optNums?.checked) charset += NUMS;
      if (optSyms?.checked) charset += SYMS;

      if (!charset) {
        out.value = 'Select at least one character set';
        return;
      }

      // Cryptographically secure random values
      const array = new Uint32Array(length);
      window.crypto.getRandomValues(array);

      let result = '';
      for (let i = 0; i < length; i++) {
        result += charset[array[i] % charset.length];
      }

      out.value = result;

      // Entropy calculation
      const entropy = Math.round(length * Math.log2(charset.length));
      if (badge && bar) {
        if (entropy < 45) {
          badge.textContent = `Weak (${entropy} Bits)`;
          badge.className = 'px-2.5 py-0.5 rounded-full bg-red-100 text-red-800 dark:bg-red-950/50 dark:text-red-300 font-bold text-xs';
          bar.className = 'h-full bg-red-500 transition-all duration-300';
          bar.style.width = '25%';
        } else if (entropy < 65) {
          badge.textContent = `Medium (${entropy} Bits)`;
          badge.className = 'px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950/50 dark:text-amber-300 font-bold text-xs';
          bar.className = 'h-full bg-amber-500 transition-all duration-300';
          bar.style.width = '55%';
        } else {
          badge.textContent = `Very Strong (${entropy} Bits)`;
          badge.className = 'px-2.5 py-0.5 rounded-full bg-green-100 text-green-800 dark:bg-green-950/50 dark:text-green-300 font-bold text-xs';
          bar.className = 'h-full bg-green-500 transition-all duration-300';
          bar.style.width = '100%';
        }
      }
    }

    slider.addEventListener('input', generate);
    [optUpper, optLower, optNums, optSyms].forEach(cb => cb?.addEventListener('change', generate));
    btnRegen?.addEventListener('click', generate);

    btnCopy?.addEventListener('click', () => {
      if (!out.value) return;
      navigator.clipboard.writeText(out.value);
      window.showToast?.('Password copied to clipboard!');
    });

    generate();
  }

  initPasswordGenerator();
  document.addEventListener('astro:page-load', initPasswordGenerator);
</script>
