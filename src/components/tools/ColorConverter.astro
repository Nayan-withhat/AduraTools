---
import type { ToolItem } from '../../data/tools';
import Icon from '../Icon.astro';

interface Props {
  tool: ToolItem;
}
const { tool } = Astro.props;
---

<div class="space-y-6" id="color-converter-root">
  <!-- Interactive Swatch & Color Picker Header -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 p-6 rounded-[var(--radius-lg)] bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] items-center">
    <!-- Live Color Preview Box (4 Cols) -->
    <div class="md:col-span-4 flex flex-col items-center justify-center space-y-3">
      <div 
        id="color-preview-box" 
        class="w-full h-32 rounded-[var(--radius-md)] border-2 border-[var(--color-hairline)] shadow-inner flex items-center justify-center transition-colors"
        style="background-color: #ff3d8b;"
      >
        <span id="contrast-sample-text" class="font-sans font-bold text-white text-base">Sample Text</span>
      </div>
      <div class="flex items-center gap-3">
        <label class="font-sans font-semibold text-xs text-neutral-600 dark:text-neutral-300">Pick Color:</label>
        <input 
          type="color" 
          id="color-picker-input" 
          value="#ff3d8b" 
          class="w-10 h-8 rounded border border-[var(--color-hairline)] cursor-pointer bg-transparent"
        />
      </div>
    </div>

    <!-- WCAG Accessibility Contrast Ratios (8 Cols) -->
    <div class="md:col-span-8 space-y-4">
      <div>
        <span class="font-mono text-xs uppercase font-bold text-neutral-400">WCAG Contrast Analysis</span>
        <h3 class="font-sans font-bold text-lg text-[var(--color-ink)]">Readability Ratios</h3>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <!-- Against White Text -->
        <div class="p-3 bg-[var(--color-surface-card)] rounded-[var(--radius-md)] border border-[var(--color-hairline)] space-y-1">
          <div class="flex items-center justify-between">
            <span class="font-sans text-xs font-semibold text-[var(--color-ink)]">White Text</span>
            <span id="badge-white-contrast" class="px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-950/50 text-green-800 dark:text-green-300 font-bold text-[10px]">Pass AA</span>
          </div>
          <div id="ratio-white" class="font-mono font-bold text-lg text-[var(--color-ink)]">4.52:1</div>
        </div>

        <!-- Against Black Text -->
        <div class="p-3 bg-[var(--color-surface-card)] rounded-[var(--radius-md)] border border-[var(--color-hairline)] space-y-1">
          <div class="flex items-center justify-between">
            <span class="font-sans text-xs font-semibold text-[var(--color-ink)]">Black Text</span>
            <span id="badge-black-contrast" class="px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-950/50 text-green-800 dark:text-green-300 font-bold text-[10px]">Pass AAA</span>
          </div>
          <div id="ratio-black" class="font-mono font-bold text-lg text-[var(--color-ink)]">4.64:1</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Synchronized Color Formats Matrix -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- HEX -->
    <div class="p-4 rounded-[var(--radius-lg)] bg-[var(--color-surface-card)] border border-[var(--color-hairline)] space-y-2">
      <div class="flex items-center justify-between">
        <span class="font-mono text-xs uppercase font-bold text-neutral-400">HEX Code</span>
        <button type="button" class="btn-copy-color btn-primary text-xs py-1 px-2.5 flex items-center gap-1" data-val-id="hex-val">
          <Icon name="copy" class="w-3 h-3" />
          <span>Copy</span>
        </button>
      </div>
      <input type="text" id="hex-val" value="#ff3d8b" class="input-base font-mono font-bold text-sm" />
    </div>

    <!-- RGB -->
    <div class="p-4 rounded-[var(--radius-lg)] bg-[var(--color-surface-card)] border border-[var(--color-hairline)] space-y-2">
      <div class="flex items-center justify-between">
        <span class="font-mono text-xs uppercase font-bold text-neutral-400">RGB Format</span>
        <button type="button" class="btn-copy-color btn-primary text-xs py-1 px-2.5 flex items-center gap-1" data-val-id="rgb-val">
          <Icon name="copy" class="w-3 h-3" />
          <span>Copy</span>
        </button>
      </div>
      <input type="text" id="rgb-val" value="rgb(255, 61, 139)" class="input-base font-mono font-bold text-sm" />
    </div>

    <!-- HSL -->
    <div class="p-4 rounded-[var(--radius-lg)] bg-[var(--color-surface-card)] border border-[var(--color-hairline)] space-y-2">
      <div class="flex items-center justify-between">
        <span class="font-mono text-xs uppercase font-bold text-neutral-400">HSL Format</span>
        <button type="button" class="btn-copy-color btn-primary text-xs py-1 px-2.5 flex items-center gap-1" data-val-id="hsl-val">
          <Icon name="copy" class="w-3 h-3" />
          <span>Copy</span>
        </button>
      </div>
      <input type="text" id="hsl-val" value="hsl(336, 100%, 62%)" class="input-base font-mono font-bold text-sm" />
    </div>

    <!-- CMYK -->
    <div class="p-4 rounded-[var(--radius-lg)] bg-[var(--color-surface-card)] border border-[var(--color-hairline)] space-y-2">
      <div class="flex items-center justify-between">
        <span class="font-mono text-xs uppercase font-bold text-neutral-400">CMYK Print</span>
        <button type="button" class="btn-copy-color btn-primary text-xs py-1 px-2.5 flex items-center gap-1" data-val-id="cmyk-val">
          <Icon name="copy" class="w-3 h-3" />
          <span>Copy</span>
        </button>
      </div>
      <input type="text" id="cmyk-val" value="cmyk(0%, 76%, 45%, 0%)" class="input-base font-mono font-bold text-sm" />
    </div>
  </div>
</div>

<script>
  function initColorConverter() {
    const picker = document.getElementById('color-picker-input') as HTMLInputElement | null;
    const preview = document.getElementById('color-preview-box');
    const contrastText = document.getElementById('contrast-sample-text');

    const hexInput = document.getElementById('hex-val') as HTMLInputElement | null;
    const rgbInput = document.getElementById('rgb-val') as HTMLInputElement | null;
    const hslInput = document.getElementById('hsl-val') as HTMLInputElement | null;
    const cmykInput = document.getElementById('cmyk-val') as HTMLInputElement | null;

    const ratioWhite = document.getElementById('ratio-white');
    const ratioBlack = document.getElementById('ratio-black');
    const badgeWhite = document.getElementById('badge-white-contrast');
    const badgeBlack = document.getElementById('badge-black-contrast');

    const copyBtns = document.querySelectorAll('.btn-copy-color') as NodeListOf<HTMLButtonElement>;

    if (!picker || !hexInput) return;

    function hexToRgb(hex: string): [number, number, number] | null {
      const match = hex.replace('#', '').match(/.{1,2}/g);
      if (!match || match.length < 3) return null;
      return [parseInt(match[0], 16), parseInt(match[1], 16), parseInt(match[2], 16)];
    }

    function rgbToHsl(r: number, g: number, b: number): [number, number, number] {
      r /= 255; g /= 255; b /= 255;
      const max = Math.max(r, g, b), min = Math.min(r, g, b);
      let h = 0, s = 0, l = (max + min) / 2;
      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        switch (max) {
          case r: h = (g - b) / d + (g < b ? 6 : 0); break;
          case g: h = (b - r) / d + 2; break;
          case b: h = (r - g) / d + 4; break;
        }
        h /= 6;
      }
      return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
    }

    function rgbToCmyk(r: number, g: number, b: number): [number, number, number, number] {
      const rP = r / 255, gP = g / 255, bP = b / 255;
      const k = 1 - Math.max(rP, gP, bP);
      if (k === 1) return [0, 0, 0, 100];
      const c = (1 - rP - k) / (1 - k);
      const m = (1 - gP - k) / (1 - k);
      const y = (1 - bP - k) / (1 - k);
      return [Math.round(c * 100), Math.round(m * 100), Math.round(y * 100), Math.round(k * 100)];
    }

    function luminance(r: number, g: number, b: number): number {
      const a = [r, g, b].map(v => {
        v /= 255;
        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      });
      return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722;
    }

    function updateAll(hex: string) {
      if (!hex.startsWith('#')) hex = '#' + hex;
      const rgb = hexToRgb(hex);
      if (!rgb) return;

      const [r, g, b] = rgb;
      const [h, s, l] = rgbToHsl(r, g, b);
      const [c, m, y, k] = rgbToCmyk(r, g, b);

      if (preview) preview.style.backgroundColor = hex;
      if (picker) picker.value = hex;

      if (hexInput && document.activeElement !== hexInput) hexInput.value = hex;
      if (rgbInput) rgbInput.value = `rgb(${r}, ${g}, ${b})`;
      if (hslInput) hslInput.value = `hsl(${h}, ${s}%, ${l}%)`;
      if (cmykInput) cmykInput.value = `cmyk(${c}%, ${m}%, ${y}%, ${k}%)`;

      const lum = luminance(r, g, b);
      const lumWhite = luminance(255, 255, 255);
      const lumBlack = luminance(0, 0, 0);

      const crWhite = (lumWhite + 0.05) / (lum + 0.05);
      const crBlack = (lum + 0.05) / (lumBlack + 0.05);

      if (ratioWhite) ratioWhite.textContent = `${crWhite.toFixed(2)}:1`;
      if (ratioBlack) ratioBlack.textContent = `${crBlack.toFixed(2)}:1`;

      if (contrastText) {
        contrastText.style.color = crWhite >= crBlack ? '#ffffff' : '#000000';
      }

      if (badgeWhite) {
        badgeWhite.textContent = crWhite >= 7 ? 'Pass AAA' : crWhite >= 4.5 ? 'Pass AA' : 'Fail';
        badgeWhite.className = crWhite >= 4.5 ? 'px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-950/50 text-green-800 dark:text-green-300 font-bold text-[10px]' : 'px-2 py-0.5 rounded-full bg-red-100 dark:bg-red-950/50 text-red-800 dark:text-red-300 font-bold text-[10px]';
      }

      if (badgeBlack) {
        badgeBlack.textContent = crBlack >= 7 ? 'Pass AAA' : crBlack >= 4.5 ? 'Pass AA' : 'Fail';
        badgeBlack.className = crBlack >= 4.5 ? 'px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-950/50 text-green-800 dark:text-green-300 font-bold text-[10px]' : 'px-2 py-0.5 rounded-full bg-red-100 dark:bg-red-950/50 text-red-800 dark:text-red-300 font-bold text-[10px]';
      }
    }

    picker.addEventListener('input', (e) => updateAll((e.target as HTMLInputElement).value));
    hexInput.addEventListener('input', (e) => updateAll((e.target as HTMLInputElement).value));

    copyBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const valId = (e.currentTarget as HTMLElement).getAttribute('data-val-id');
        const inputEl = document.getElementById(valId || '') as HTMLInputElement | null;
        if (inputEl && inputEl.value) {
          navigator.clipboard.writeText(inputEl.value);
          window.showToast?.(`Copied ${inputEl.value}!`);
        }
      });
    });

    updateAll('#ff3d8b');
  }

  initColorConverter();
  document.addEventListener('astro:page-load', initColorConverter);
</script>
