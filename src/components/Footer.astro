---
import { CATEGORIES } from '../data/categories';
import Icon from './Icon.astro';
---

<footer class="w-full bg-[var(--color-surface-soft)] border-t border-[var(--color-hairline)] pt-16 pb-12 transition-colors">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Top Grid: Brand & Directory Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Brand Column (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5 text-decoration-none">
          <div class="w-8 h-8 rounded-lg bg-[var(--color-primary)] text-[var(--color-on-primary)] flex items-center justify-center font-mono font-bold text-sm">
            <Icon name="sparkles" class="w-4 h-4" />
          </div>
          <span class="font-sans font-bold text-lg tracking-tight text-[var(--color-ink)]">
            Adura<span class="font-normal text-neutral-400">Tools</span>
          </span>
        </a>
        <p class="font-body-sm text-[var(--color-ink-muted)] text-sm max-w-sm leading-relaxed">
          The privacy-first developer and digital toolkit. Every calculation, format, and conversion runs locally in your browser with zero latency and zero data retention.
        </p>

        <div class="flex items-center gap-3 pt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[var(--color-surface-card)] border border-[var(--color-hairline)] text-xs font-mono font-medium text-[var(--color-ink)]">
            <span class="w-2 h-2 rounded-full bg-[var(--color-semantic-success)]"></span>
            100% In-Browser
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[var(--color-surface-card)] border border-[var(--color-hairline)] text-xs font-mono font-medium text-[var(--color-ink)]">
            <Icon name="shield-check" class="w-3.5 h-3.5 text-[var(--color-ink-muted)]" />
            Zero Telemetry
          </span>
        </div>
      </div>

      <!-- Categories Links (Col 3 & 4) -->
      <div class="space-y-3">
        <div class="font-eyebrow text-[var(--color-ink-muted)] text-xs">Categories</div>
        <ul class="space-y-2 text-xs">
          {CATEGORIES.slice(0, 4).map(cat => (
            <li>
              <a href={`/categories/${cat.slug}`} class="text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] text-decoration-none transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-3">
        <div class="font-eyebrow text-[var(--color-ink-muted)] text-xs">More Categories</div>
        <ul class="space-y-2 text-xs">
          {CATEGORIES.slice(4).map(cat => (
            <li>
              <a href={`/categories/${cat.slug}`} class="text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] text-decoration-none transition-colors">
                {cat.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/all-tools" class="text-[var(--color-ink)] font-semibold hover:underline text-decoration-none">
              All 34+ Tools →
            </a>
          </li>
        </ul>
      </div>

      <!-- Platform / Legal Column -->
      <div class="space-y-3">
        <div class="font-eyebrow text-[var(--color-ink-muted)] text-xs">Platform</div>
        <ul class="space-y-2 text-xs">
          <li><a href="/about" class="text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] text-decoration-none transition-colors">About & Architecture</a></li>
          <li><a href="/privacy" class="text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] text-decoration-none transition-colors">Privacy Manifesto</a></li>
          <li><a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] text-decoration-none transition-colors">Source Architecture</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-[var(--color-hairline)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[var(--color-ink-muted)]">
      <div>
        © {new Date().getFullYear()} AduraTools (aduratools.site). All rights reserved.
      </div>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-[var(--color-ink)] text-decoration-none transition-colors">Zero-Data Policy</a>
        <a href="/all-tools" class="hover:text-[var(--color-ink)] text-decoration-none transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
